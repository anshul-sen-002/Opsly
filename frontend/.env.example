# Production — set via the Vercel dashboard Environment Variables:
#   Settings → Environment Variables → Add
#   Name:   NEXT_PUBLIC_API_URL
#   Value:  https://<your-backend>.onrender.com
# (Keep this file for local reference; Vercel does not read .env.local
#  or .env.example during deployment builds.)
NEXT_PUBLIC_API_URL=https://opsly-backend.onrender.com

