# ===========================================================================
#  Backend environment-variable template
#  Copy to `backend/.env` for local dev, or set these as Render env vars
#  for production.  NEVER commit the real `.env` file.
#
#  Database:  Aiven managed PostgreSQL  (https://aiven.io)
#  Backend:   Render                                      (https://render.com)
#  Frontend:  Vercel                                      (https://vercel.com)
# ===========================================================================

# ---- Database (Aiven PostgreSQL) ----------------------------------------
# Get the JDBC URL from your Aiven service dashboard.
# It looks like:  jdbc:postgresql://pg-12345.aivencloud.com:25390/sop_db?sslmode=require
DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=<aiven_service_username>
DB_PASSWORD=<aiven_service_password>

# ---- JWT -----------------------------------------------------------------
# Generate a secure 64-char hex string, e.g.:
#   openssl rand -hex 32
JWT_SECRET=<64-char-hex-secret>
JWT_EXPIRATION=900000          # access token lifetime (15 min)
JWT_REFRESH_EXPIRATION=604800000  # refresh token lifetime (7 days)

# ---- Initial admin bootstrap --------------------------------------------
INITIAL_ADMIN_EMAIL=you@example.com
INITIAL_ADMIN_PASSWORD=<strong-password>

# ---- CORS ----------------------------------------------------------------
# The full Vercel deployment URL(s) of your frontend, comma-separated.
# Example:  https://opsly-frontend.vercel.app
ALLOWED_ORIGINS=https://opsly-frontend.vercel.app

# ---- AI / OpenRouter (optional) ------------------------------------------
# Leave OPENROUTER_API_KEY empty (or remove) to disable the AI assistant.
# Free models: google/gemini-2.5-flash-preview-04-17, openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-preview-04-17

# ---- Swagger -------------------------------------------------------------
SWAGGER_UI_PATH=/swagger-ui.html
SWAGGER_DOCS_PATH=/v3/api-docs

# ---- Cloudinary (optional — for file/image uploads) ---------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
